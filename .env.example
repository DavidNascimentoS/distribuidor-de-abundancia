# Copy to .env and fill in. Never commit .env.

# String you invent; same value goes in the Meta app webhook config
WA_VERIFY_TOKEN=
# App Secret (Meta app > Settings > Basic) — used to validate signatures
WA_APP_SECRET=
# Permanent System User token (Business Manager)
WA_ACCESS_TOKEN=
# ID of the WhatsApp number (WhatsApp > API Setup)
WA_PHONE_NUMBER_ID=
# Graph API version — check the current one in Meta docs
WA_API_VERSION=v23.0

# Postgres + PostGIS. Not read by the app yet; used to apply db/migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abundancia
