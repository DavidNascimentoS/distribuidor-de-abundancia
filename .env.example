# Copy to .env and fill in. Never commit .env.

# String you invent; same value goes in the Meta app webhook config
WA_VERIFY_TOKEN=
# App Secret (Meta app > Settings > Basic) — used to validate signatures
WA_APP_SECRET=
# Permanent System User token (Business Manager)
WA_ACCESS_TOKEN=
# ID of the WhatsApp number (WhatsApp > API Setup)
WA_PHONE_NUMBER_ID=
# Graph API version — check the current one in Meta docs
WA_API_VERSION=v23.0

# Postgres + PostGIS. The README's Docker command maps the container to host port 5433 so it
# does not clash with a Postgres already installed on the machine. The app fails at startup
# if it cannot connect.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/abundancia

# Key for the HMAC-SHA256 of phone numbers (person_pii.phone_hash). Generate a long random
# string, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
# Changing it orphans every existing participant: treat it like a database password.
PII_HMAC_KEY=
